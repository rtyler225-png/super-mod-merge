<?xml version='1.0' encoding='us-ascii'?>
<Tables>
	<Table Name="Standard" Type="BuildingBuildList">
		<!-- KEEP SHORT. Trigger 36 walks this every 1500ms out of a small per-think budget shared -->
		<!-- with the train manager. Shipped tables are 4-16 rows; use bigger targets, not more rows. -->

		<!-- SOCKET BUDGET IS THE REAL CONSTRAINT, NOT MONEY. A Fortress has 7 interior sockets and -->
		<!-- EconMultiplier is 4.2x, so supply pads are the cheap part - every socket spent on -->
		<!-- economy is a factory the AI does not have. An earlier version reserved 6 of 7 sockets -->
		<!-- for economy and tech, leaving one Barracks and one Vehicle Depot, and the AI sat on a -->
		<!-- huge bank because it had nowhere to spend it. Production first. -->

		<!-- NO unsc_bldg_command_02 ROWS. Trigger 2733 blocks every base claim while a command_02 -->
		<!-- bid is pending, and a Station is transient on the way to a Fortress so that target is -->
		<!-- never satisfied. It also strands the base-grab army (Trigger 2283 commits the whole -->
		<!-- Reserves pool). command_03 is a stable end state and is NOT checked by that gate. -->
		<Row><c>unsc_bldg_supplypad_01</c><c>2</c><c>1</c></Row>
		<Row><c>unsc_bldg_barracks_01</c><c>1</c><c>1</c></Row>
		<Row><c>unsc_bldg_vehicledepot_01</c><c>1</c><c>1</c></Row>
		<Row><c>unsc_bldg_reactor_01</c><c>1</c><c>1</c></Row>
		<Row><c>unsc_bldg_supplypad_02</c><c>2</c><c>1</c></Row>
		<!-- Only building that can research unsc_tech_reinforcements (120 -> 280 pop cap). -->
		<Row><c>unsc_bldg_fieldArmory_01</c><c>1</c><c>1</c></Row>
		<!-- Wildcard production: turns every remaining base-1 socket into a factory. -->
		<Row><c>_ProductionBuildingNotBase</c><c>4</c><c>1</c></Row>
		<!-- Fortress: satisfied for Cutter, this is the upgrade for Forge/Anders/Serina. -->
		<Row><c>unsc_bldg_command_03</c><c>1</c><c>1</c></Row>
		<Row><c>unsc_bldg_airPad_01</c><c>1</c><c>1</c></Row>
		<Row><c>unsc_bldg_turret_01</c><c>2</c><c>1</c></Row>
		<Row><c>unsc_bldg_turretAA_01</c><c>1</c><c>1</c></Row>
		<Row><c>unsc_bldg_turretAV_01</c><c>1</c><c>1</c></Row>

		<!-- PRIORITY 2. Reached as soon as the opening Barracks exists (Trigger 2492). -->
		<!-- Expansion pushed hard and every new socket biased toward production. -->
		<Row><c>unsc_bldg_command_01</c><c>2</c><c>2</c></Row>
		<Row><c>_ProductionBuildingNotBase</c><c>8</c><c>2</c></Row>
		<Row><c>unsc_bldg_supplypad_01</c><c>6</c><c>2</c></Row>
		<Row><c>unsc_bldg_command_01</c><c>3</c><c>2</c></Row>
		<Row><c>unsc_bldg_supplypad_02</c><c>6</c><c>2</c></Row>
		<Row><c>unsc_bldg_reactor_01</c><c>3</c><c>2</c></Row>
		<Row><c>unsc_bldg_command_03</c><c>2</c><c>2</c></Row>
		<Row><c>unsc_bldg_turret_01</c><c>5</c><c>2</c></Row>
		<Row><c>unsc_bldg_turretAA_01</c><c>3</c><c>2</c></Row>
		<Row><c>unsc_bldg_turretAV_01</c><c>3</c><c>2</c></Row>

		<Row><c>unsc_bldg_command_01</c><c>4</c><c>2</c></Row>
		<Row><c>_ProductionBuildingNotBase</c><c>14</c><c>2</c></Row>
		<Row><c>unsc_bldg_supplypad_01</c><c>12</c><c>2</c></Row>
		<Row><c>unsc_bldg_command_01</c><c>5</c><c>2</c></Row>
		<Row><c>unsc_bldg_supplypad_02</c><c>12</c><c>2</c></Row>
		<Row><c>unsc_bldg_reactor_01</c><c>6</c><c>2</c></Row>
		<Row><c>unsc_bldg_command_03</c><c>5</c><c>2</c></Row>
		<Row><c>unsc_bldg_turret_01</c><c>10</c><c>2</c></Row>
		<Row><c>unsc_bldg_turretAA_01</c><c>5</c><c>2</c></Row>
		<Row><c>unsc_bldg_turretAV_01</c><c>5</c><c>2</c></Row>

		<!-- Socket filler tail. Trigger 2729 only grabs a base when EmptySockets == 0 across every -->
		<!-- base owned. 8 bases x 7 sockets = 56; these totals reach 61. Big targets, few rows. -->
		<Row><c>unsc_bldg_command_01</c><c>6</c><c>2</c></Row>
		<Row><c>_ProductionBuildingNotBase</c><c>20</c><c>2</c></Row>
		<Row><c>unsc_bldg_supplypad_01</c><c>30</c><c>2</c></Row>
		<Row><c>unsc_bldg_reactor_01</c><c>10</c><c>2</c></Row>
		<Row><c>unsc_bldg_supplypad_02</c><c>28</c><c>2</c></Row>
	</Table>
</Tables>
