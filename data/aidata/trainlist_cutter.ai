<?xml version='1.0' encoding='us-ascii'?>
<Tables>
	<Table Name="Standard" Type="SquadBuildList">
		<!-- UNIVERSAL UNSC COMBINED-ARMS BASELINE. Copy to the other UNSC leaders as-is. -->
		<!-- Every live squad trains at the GENERIC buildings (barracks_01 / vehicledepot_01 / airPad_01). -->
		<!-- -->
		<!-- This is a BUILD ORDER, not proportions. Trigger 131 bids the FIRST row where owned < -->
		<!-- target and the chain then ends, restarting from row 0 every 1500ms. Counts are -->
		<!-- CUMULATIVE, so types repeat with rising targets to interleave the army. -->
		<!-- -->
		<!-- KEEP THE LIVE SECTION SHORT. The walk costs ~10 trigger evaluations per row out of a -->
		<!-- small per-think budget shared with the build manager. A 69 row version starved it and -->
		<!-- the AI nearly stopped producing units AND buildings. Shipped tables run 30-54 rows. -->

		<!-- Wave 1: opening. Barracks only. Rockets and snipers immediately so an early poke is answered. -->
		<Row><c>unsc_inf_marine_01</c><c>4</c></Row>
		<Row><c>unsc_veh_warthog_01</c><c>2</c></Row>
		<Row><c>unsc_inf_marinerocket_01</c><c>3</c></Row>
		<Row><c>unsc_inf_marinesniper_01</c><c>3</c></Row>

		<!-- Wave 2: armour, dedicated AA and the first air all come online together. -->
		<Row><c>unsc_veh_scorpion_01</c><c>2</c></Row>
		<Row><c>unsc_inf_marine_01</c><c>9</c></Row>
		<Row><c>unsc_veh_wolverine_01</c><c>2</c></Row>
		<Row><c>unsc_air_hornet_01</c><c>2</c></Row>
		<Row><c>unsc_inf_flameMarine_01</c><c>3</c></Row>
		<Row><c>unsc_inf_MedicBR_01</c><c>2</c></Row>

		<!-- Wave 3: artillery joins, air keeps pace with ground. -->
		<Row><c>unsc_veh_scorpion_01</c><c>5</c></Row>
		<Row><c>unsc_veh_cobra_01</c><c>3</c></Row>
		<Row><c>unsc_inf_marine_01</c><c>15</c></Row>
		<Row><c>unsc_inf_marinerocket_01</c><c>7</c></Row>
		<Row><c>unsc_veh_warthog_01</c><c>6</c></Row>
		<Row><c>unsc_air_hornet_01</c><c>5</c></Row>

		<!-- Wave 4 -->
		<Row><c>unsc_veh_scorpion_01</c><c>9</c></Row>
		<Row><c>unsc_veh_wolverine_01</c><c>4</c></Row>
		<Row><c>unsc_inf_marine_01</c><c>20</c></Row>
		<Row><c>unsc_veh_cobra_01</c><c>6</c></Row>
		<Row><c>unsc_inf_marinesniper_01</c><c>6</c></Row>
		<Row><c>unsc_inf_flameMarine_01</c><c>6</c></Row>
		<Row><c>unsc_air_pelicangunship_01</c><c>1</c></Row>

		<!-- Wave 5 -->
		<Row><c>unsc_veh_scorpion_01</c><c>12</c></Row>
		<Row><c>unsc_air_hornet_01</c><c>8</c></Row>
		<Row><c>unsc_inf_marine_01</c><c>24</c></Row>
		<Row><c>unsc_inf_marinerocket_01</c><c>11</c></Row>
		<Row><c>unsc_veh_wolverine_01</c><c>6</c></Row>
		<Row><c>unsc_veh_warthog_01</c><c>9</c></Row>
		<Row><c>unsc_inf_MedicBR_01</c><c>5</c></Row>
		<Row><c>unsc_veh_cobra_01</c><c>8</c></Row>

		<!-- Wave 6: final targets. Also battlefield REPLACEMENT priority, since these are the rows that go
		     deficient when units die. Armour, AA and air are listed ahead of the cheap infantry. -->
		<Row><c>unsc_veh_scorpion_01</c><c>15</c></Row>
		<Row><c>unsc_veh_wolverine_01</c><c>9</c></Row>
		<Row><c>unsc_veh_cobra_01</c><c>10</c></Row>
		<Row><c>unsc_air_hornet_01</c><c>12</c></Row>
		<Row><c>unsc_inf_marinerocket_01</c><c>14</c></Row>
		<Row><c>unsc_air_pelicangunship_01</c><c>2</c></Row>
		<Row><c>unsc_inf_marine_01</c><c>26</c></Row>
		<Row><c>unsc_inf_flameMarine_01</c><c>8</c></Row>
		<Row><c>unsc_inf_marinesniper_01</c><c>8</c></Row>
		<Row><c>unsc_inf_MedicBR_01</c><c>8</c></Row>
		<Row><c>unsc_veh_warthog_01</c><c>12</c></Row>

		<!-- ==================== FULL UNSC ROSTER (disabled) ==================== -->
		<!-- Every squad trainable at a UNSC building that is not already live above, so this one -->
		<!-- table can be copied to any UNSC leader and specialised without hunting proto names. -->
		<!-- To enable one: uncomment it and MOVE it up into the waves at a sensible cumulative -->
		<!-- target. Remember targets are cumulative per squad and must strictly increase. -->
		<!-- -->
		<!-- These are XML COMMENTS on purpose. Do NOT leave a unit disabled here as a live row -->
		<!-- with a target of 0. A zeroed row is skipped at the BID stage, not the WALK stage: -->
		<!-- Trigger 131 still runs the full per row chain, including a GetSquads call, before -->
		<!-- finding it satisfied, so it costs the same think budget as a live row. All 64 UNSC -->
		<!-- squads as zeroed rows would put this table near 94 rows, worse than the 69 row -->
		<!-- version that starved the budget and nearly stopped the AI producing at all. -->
		<!-- Commented out costs nothing; the parser never sees it. -->
		<!-- -->
		<!-- Grouped by which leader owns the building that trains them. Generic works for every -->
		<!-- UNSC leader; the rest need that leader to actually own that building. -->
		<!-- ==== Generic (31) ==== -->
