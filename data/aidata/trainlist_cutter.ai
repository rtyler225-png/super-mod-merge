<?xml version='1.0' encoding='us-ascii'?>
<Tables>
	<Table Name="Standard" Type="SquadBuildList">
		<!-- UNIVERSAL UNSC COMBINED-ARMS BASELINE. Copy to the other UNSC leaders as-is. -->
		<!-- Every squad trains at the GENERIC buildings (barracks_01 / vehicledepot_01 / airPad_01). -->

		<!-- This is a BUILD ORDER, not proportions. Trigger 131 bids the FIRST row where owned < -->
		<!-- target and the chain then ends, restarting from row 0 every 1500ms. Counts are -->
		<!-- CUMULATIVE, so types are repeated with rising targets to interleave the army. -->

		<!-- KEEP THIS TABLE SHORT. The walk costs ~10 trigger evaluations per row and the AI has a -->
		<!-- small per-think budget on Heroic, shared with the build manager via the topic lottery. -->
		<!-- A 69-row version of this table starved that budget and the AI nearly stopped producing -->
		<!-- units AND buildings. Shipped tables run 30-54 rows; stay in that range. -->

		<!-- Wave 1: opening. Rockets and snipers immediately so an early poke is answered. -->
		<Row><c>unsc_inf_marine_01</c><c>4</c></Row>
		<Row><c>unsc_veh_warthog_01</c><c>2</c></Row>
		<Row><c>unsc_inf_marinerocket_01</c><c>3</c></Row>
		<Row><c>unsc_inf_marinesniper_01</c><c>3</c></Row>

		<!-- Wave 2: first armour, first dedicated AA, first sustain -->
		<Row><c>unsc_veh_scorpion_01</c><c>2</c></Row>
		<Row><c>unsc_inf_marine_01</c><c>10</c></Row>
		<Row><c>unsc_veh_wolverine_01</c><c>2</c></Row>
		<Row><c>unsc_inf_flameMarine_01</c><c>3</c></Row>
		<Row><c>unsc_air_hornet_01</c><c>1</c></Row>
		<Row><c>unsc_inf_MedicBR_01</c><c>2</c></Row>

		<!-- Wave 3 -->
		<Row><c>unsc_veh_scorpion_01</c><c>5</c></Row>
		<Row><c>unsc_inf_marine_01</c><c>18</c></Row>
		<Row><c>unsc_veh_cobra_01</c><c>3</c></Row>
		<Row><c>unsc_inf_marinerocket_01</c><c>7</c></Row>
		<Row><c>unsc_veh_warthog_01</c><c>6</c></Row>
		<Row><c>unsc_inf_marinesniper_01</c><c>6</c></Row>

		<!-- Wave 4 -->
		<Row><c>unsc_veh_scorpion_01</c><c>9</c></Row>
		<Row><c>unsc_inf_marine_01</c><c>26</c></Row>
		<Row><c>unsc_veh_wolverine_01</c><c>4</c></Row>
		<Row><c>unsc_air_hornet_01</c><c>3</c></Row>
		<Row><c>unsc_inf_flameMarine_01</c><c>6</c></Row>
		<Row><c>unsc_veh_cobra_01</c><c>5</c></Row>
		<Row><c>unsc_inf_MedicBR_01</c><c>4</c></Row>

		<!-- Wave 5 -->
		<Row><c>unsc_veh_scorpion_01</c><c>13</c></Row>
		<Row><c>unsc_inf_marine_01</c><c>34</c></Row>
		<Row><c>unsc_inf_marinerocket_01</c><c>11</c></Row>
		<Row><c>unsc_veh_warthog_01</c><c>9</c></Row>
		<Row><c>unsc_air_hornet_01</c><c>6</c></Row>
		<Row><c>unsc_veh_wolverine_01</c><c>6</c></Row>
		<Row><c>unsc_inf_marinesniper_01</c><c>8</c></Row>
		<Row><c>unsc_air_pelicangunship_01</c><c>1</c></Row>

		<!-- Wave 6: final targets. Also sets battlefield REPLACEMENT priority - these are the rows -->
		<!-- that go deficient when units die, so the backbone and counters are listed first. -->
		<Row><c>unsc_veh_scorpion_01</c><c>16</c></Row>
		<Row><c>unsc_veh_wolverine_01</c><c>8</c></Row>
		<Row><c>unsc_veh_cobra_01</c><c>8</c></Row>
		<Row><c>unsc_inf_marinerocket_01</c><c>14</c></Row>
		<Row><c>unsc_air_hornet_01</c><c>8</c></Row>
		<Row><c>unsc_inf_marine_01</c><c>40</c></Row>
		<Row><c>unsc_inf_flameMarine_01</c><c>10</c></Row>
		<Row><c>unsc_inf_marinesniper_01</c><c>10</c></Row>
		<Row><c>unsc_inf_MedicBR_01</c><c>8</c></Row>
		<Row><c>unsc_veh_warthog_01</c><c>12</c></Row>

		<!-- ============ CANONICAL UNSC ROSTER (all targets 0 = inert) ============ -->
		<!-- A target of 0 can never be deficient, so these rows never produce a bid, and -->
		<!-- TrainListMultiplier cannot revive them either (0 x 3 is still 0). They exist so this one -->
		<!-- table can be copied to every UNSC leader and specialised by changing a 0 to a number -->
		<!-- instead of adding rows - e.g. Forge flips warthoglce and elephant, Serina flips -->
		<!-- cryoMarine and warthogcryo, Anders flips gremlin and hawk. -->
		<!-- -->
		<!-- THEY MUST STAY AT THE BOTTOM. A zeroed row is skipped at the BID stage, not the WALK -->
		<!-- stage - Trigger 131 still runs the full per-row chain including a GetSquads call before -->
		<!-- deciding it is satisfied. The walk stops at the first deficient row, so parked down here -->
		<!-- they are only ever reached when everything above is already satisfied. Put one of these -->
		<!-- higher up and it costs the same think budget as a live row, every pass. -->
		<!-- When specialising a leader, MOVE the row up into the waves rather than editing in place. -->
		<Row><c>unsc_inf_odst_01</c><c>0</c></Row>
		<Row><c>unsc_inf_spartan_01</c><c>0</c></Row>
		<Row><c>unsc_inf_cyclops_01</c><c>0</c></Row>
		<Row><c>unsc_inf_cryoMarine_01</c><c>0</c></Row>
		<Row><c>unsc_inf_marineshotgun_01</c><c>0</c></Row>
		<Row><c>unsc_veh_gremlin_01</c><c>0</c></Row>
		<Row><c>unsc_veh_warthoggauss_01</c><c>0</c></Row>
		<Row><c>unsc_veh_warthoglce_01</c><c>0</c></Row>
		<Row><c>unsc_veh_warthogcryo_01</c><c>0</c></Row>
		<Row><c>unsc_veh_elephant_01</c><c>0</c></Row>
		<Row><c>unsc_air_hawk_01</c><c>0</c></Row>
		<Row><c>unsc_air_vulture_01</c><c>0</c></Row>
	</Table>
</Tables>
