<?xml version="1.0" encoding="utf-8"?>
<Tables>
	<Table Name="Standard" Type="BuildingBuildList">
		<!-- Stages 1/2 require 1/2 owned bases; stage 3 counts are PER OWNED BASE, scaled by the Standard trigger. Covenant mapping: supply depot = supply pad, heavy factory = vehicle depot, KING TEMPLE = reactor (it carries _PowerLevelBuilding, the plain Temple does not), light factory = air building (Banshee/Vampire), Temple = field armory (hero, followers, turret and leader-power research). The landing pad is an extra Covenant building with no UNSC analogue and carries the Seraph. No base bids here. Upgraded depot and king temple tiers are counted by family. Arbiter's barracks, heavy factory and light factory all transform into Arbiter variants and are counted by variant triggers; his Temple is requested directly as templeArbiter_01. -->
		<Row><c>cov_bldg_supplyDepot_01</c><c>2</c><c>1</c></Row>
		<Row><c>cov_bldg_heavyfactory_01</c><c>1</c><c>1</c></Row>
		<Row><c>cov_bldg_kingtemple_01</c><c>2</c><c>1</c></Row>
		<Row><c>cov_bldg_barracks_01</c><c>1</c><c>1</c></Row>
		<Row><c>cov_bldg_lightfactory_01</c><c>1</c><c>1</c></Row>
		<Row><c>cov_bldg_turret_01</c><c>1</c><c>1</c></Row>
		<Row><c>cov_bldg_supplyDepot_01</c><c>5</c><c>2</c></Row>
		<Row><c>cov_bldg_heavyfactory_01</c><c>3</c><c>2</c></Row>
		<Row><c>cov_bldg_lightfactory_01</c><c>2</c><c>2</c></Row>
		<Row><c>cov_bldg_templeArbiter_01</c><c>1</c><c>2</c></Row>
		<Row><c>cov_bldg_landingpad_02</c><c>1</c><c>2</c></Row>
		<Row><c>cov_bldg_turret_01</c><c>2</c><c>2</c></Row>
		<Row><c>cov_bldg_supplyDepot_01</c><c>4</c><c>3</c></Row>
		<Row><c>cov_bldg_heavyfactory_01</c><c>2</c><c>3</c></Row>
		<Row><c>cov_bldg_lightfactory_01</c><c>1</c><c>3</c></Row>
		<Row><c>cov_bldg_turret_01</c><c>1</c><c>3</c></Row>
	</Table>
