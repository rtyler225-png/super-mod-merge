<?xml version="1.0" encoding="us-ascii"?>
<damagetemplate>
	<percentagebased>
		<event>
			<action type="multiframeTextureIndex" fromindex="0" toindex="0" />
		</event>
		<event>
			<action type="multiframeTextureIndex" fromindex="0" toindex="1" />
			<action type="attachparticle" effect="effects\building_FX\unsc\damage\electricity_looping_01">bone_damagefx_01</action>
			<action type="attachparticle" effect="effects\building_FX\unsc\damage\LoopingSmokeFire_02">bone_damagefx_02</action>
		</event>
		<event>
			<action type="multiframeTextureIndex" fromindex="1" toindex="2" />
			<action type="attachparticle" effect="effects\building_fx\unsc\damage\LoopingSmokeFire_02">bone_damagefx_03</action>
		</event>
		<event>
			<action type="multiframeTextureIndex" fromindex="2" toindex="3" />
			<action type="attachparticle" effect="effects\building_fx\unsc\damage\electricity_looping_01">bone_damagefx_04</action>
			<action type="attachparticle" effect="effects\building_fx\unsc\damage\LoopingSmokeFire_02">bone_damagefx_05</action>
		</event>
		<event>
			<action type="multiframeTextureIndex" fromindex="3" toindex="4" />
			<action type="attachparticle" effect="effects\building_fx\unsc\damage\LoopingSmokeFire_02">impact_bone_06</action>
		</event>
		<event>
			<action type="attachparticle" effect="effects\building_fx\unsc\damage\deathdebris_01">GrannyRootBone</action>
			<action type="playsound">play_unsc_scorpion_death</action>
		</event>
	</percentagebased>
