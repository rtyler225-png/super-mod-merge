<Controls>
   <Mode name="Main">
      <Control name="ButtonA"             command="accept"  event="start" sound="" />
      <Control name="ButtonB"             command="cancel"  event="start" sound="" />

      <Control name="StickLeftUp"         command="navUp"   event="start" digital="" threshold="0.90" repeat="" delay="0.2" rate="0.1" sound="play_partysystem_menu_up_down" />
      <Control name="StickLeftDown"       command="navDown" event="start" digital="" threshold="0.90" repeat="" delay="0.2" rate="0.1" sound="play_partysystem_menu_up_down" />

      <Control name="DpadUp"              command="navUp"   event="start" repeat="" delay="0.2" rate="0.1" sound="play_partysystem_menu_up_down" />
      <Control name="DpadDown"            command="navDown" event="start" repeat="" delay="0.2" rate="0.1" sound="play_partysystem_menu_up_down" />

      <Control name="MouseWheelUp"        command="navUp"   event="start" threshold="0.9" sound="" />
      <Control name="MouseWheelDown"      command="navDown" event="start" threshold="0.9" sound="" />
      <Control name="KeyUp"               command="navUp"   event="start" repeat="" delay="0.2" rate="0.1" sound="" />
      <Control name="KeyDown"             command="navDown" event="start" repeat="" delay="0.2" rate="0.1" sound="" />
      <Control name="KeyEnter"            command="accept"  event="start" sound="" />
      <Control name="KeyNumpadEnter"      command="accept"  event="start" sound="" />
   </Mode>
</Controls>
